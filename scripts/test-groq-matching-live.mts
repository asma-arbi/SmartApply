import fs from 'node:fs';import {parseEnv} from 'node:util';import {strict as assert} from 'node:assert';
import {GroqAi} from '../backend/src/studio/ai.ts';import {groundMatches,type MatchingOffer} from '../backend/src/studio/matching.ts';
const read=(p:string)=>fs.existsSync(p)?parseEnv(fs.readFileSync(p,'utf8')):{};const env={...read('backend/.env'),...read('.env'),...process.env};if(!env.GROQ_API_KEY)throw Error('GROQ_API_KEY unavailable');
const cv='Fictional CV: final-year software engineering student. Built a Python API with MongoDB for a data dashboard. Wrote automated tests and documentation with classmates. Created a JavaScript interface to display results. Seeking a software engineering internship.';
const offer=(id:string,title:string,description:string,skills:string[]):MatchingOffer=>({id,companyId:'fictional',companyName:'Nova Demo',title,description,skills,location:'Tunis',contract:'Stage PFE',workMode:'onsite',publishedAt:new Date().toISOString()});
const offers=[offer('backend','Stage Backend Python','Develop a Python API with MongoDB. Write automated tests and documentation.', ['Python','MongoDB']),offer('devops','Cloud Engineer','Required Kubernetes and AWS experience. Deploy and operate cloud infrastructure.', ['Kubernetes','AWS']),offer('frontend','Stage Frontend JavaScript','Create a JavaScript interface. Collaborate with a team and document development.', ['JavaScript'])];
const ai=new GroqAi(env.GROQ_API_KEY,env.GROQ_MODEL||undefined);const result=groundMatches(await ai.match(cv,offers),cv,offers);assert(result.some(r=>r.id==='backend'));assert(result.find(r=>r.id==='backend')!.score>=(result.find(r=>r.id==='devops')?.score||0));assert(result.every(r=>r.criteria.every(c=>!c.matched||!!c.cvEvidence)));
console.log(JSON.stringify({passed:true,results:result.map(r=>({id:r.id,score:r.score,matched:r.matchedCount,total:r.totalCriteria}))}));
