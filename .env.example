# Chaîne de connexion MongoDB Atlas Cloud
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smartapply?retryWrites=true&w=majority

# Clé secrète pour la signature JWT (Access Tokens)
JWT_SECRET=votre_cle_secrete_jwt_robuste_au_moins_32_caracteres_2026

# Google reCAPTCHA v3
# Clé de site (Site Key) visible côté client
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Clé secrète (Secret Key) pour l'API Google siteverify
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Seuil de score reCAPTCHA v3 (défaut : 0.5)
RECAPTCHA_SCORE_THRESHOLD=0.5

# URL racine du site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
