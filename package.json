    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "jose": "^6.2.15",
    "lucide-react": "^1.70.0",
    "mongodb": "^7.8.0",
    "mongoose": "^9.12.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "7.90.0",
    "sonner": "2.0.8",
    "zod": "4.6.7",
