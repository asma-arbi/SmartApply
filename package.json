{
  "name": "jobboard",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "packages/data"
  ],
  "scripts": {
    "build:data": "npm run build --workspace @smartapply/data",
    "predev": "npm run build:data",
    "dev": "next dev",
    "prebuild": "npm run build:data",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.mjs",
    "dev:modules": "node scripts/modules-launch.cjs dev",
    "build:modules": "node scripts/modules-launch.cjs build",
    "test:modules": "node scripts/modules-launch.cjs test",
    "typecheck:modules": "node scripts/modules-launch.cjs typecheck",
    "test:preservation": "node scripts/check-module-preservation.mjs",
    "test:modules:e2e": "node scripts/modules-launch.cjs browser",
    "seed:workflows": "node scripts/seed-workflows.mjs",
    "test:workflows": "node --test cv-module/tests/applications-workflow.node.mjs",
    "test:workflows:browser": "node scripts/test-applications-browser.mjs",
    "test:session-cache": "node --test cv-module/tests/service-worker.node.cjs",
    "test:account-switch": "node scripts/test-account-switch-browser.mjs",
    "test:cover-letter": "node --test cv-module/tests/cover-letter-workflow.node.mjs",
    "test:cover-letter:live": "tsx scripts/test-groq-letter-live.mts",
    "test:application-errors": "node scripts/test-application-hub-errors.cjs",
    "test:matching": "node --test cv-module/tests/matching-workflow.node.mjs",
    "test:matching:ui": "node scripts/test-matching-ui.cjs",
    "test:matching:live": "tsx scripts/test-groq-matching-live.mts",
    "test:matching:e2e": "node scripts/test-matching-full.mjs"
  },
  "dependencies": {
    "@fontsource/inter": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
