# ═══════════════════════════════════════════════════════════════
# SMARTAPPLY TUNISIA — CONFIGURATION MONGODB ATLAS & AUTHENTIFICATION
# ═══════════════════════════════════════════════════════════════

# Base de données MongoDB Local (pour développement)
# Pour utiliser MongoDB Atlas, changez vers: mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017/smartapply

# Secret JWT pour les tokens d'accès (Edge & Server Actions)
JWT_SECRET=smartapply_jwt_super_secret_key_minimum_32_characters_long_2026_esprit_senior

# Google reCAPTCHA v3
# Clé publique du site (utilisée par le script frontend)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI

# Clé secrète serveur (utilisée par l'API siteverify de Google)
RECAPTCHA_SECRET_KEY=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

# Seuil de score minimal reCAPTCHA v3 (de 0.0 à 1.0, 0.5 recommandé)
RECAPTCHA_SCORE_THRESHOLD=0.5

# URL racine de l'application
NEXT_PUBLIC_SITE_URL=http://localhost:3000